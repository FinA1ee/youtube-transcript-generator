{
  "name": "youtube-subscript-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/worker/index.ts",
    "build": "npm run build:client",
    "build:client": "vite build --config vite.client.config.ts && node scripts/embed-client.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "fast-xml-parser": "^4.5.1",
    "hono": "^4.6.16",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.18.0",
    "postcss": "^8.5.14",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.8",
    "wrangler": "^4.86.0"
  }
}
